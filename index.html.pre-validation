    function injectKEducationSection(){ return ensureEconomySections(); }
    function injectCasinoSection(){ return ensureEconomySections(); }

    // Existing profile passport renderer reads u._licenses/u.licenses, so no separate document UI is created here.
    // Patch it once to merge the external /licenses record with purchased in-user licenses.
    const oldOpenPassport=window.openPassport;
    if(typeof oldOpenPassport==='function' && !oldOpenPassport.__kapaniMerged){
      // Leave its original rendering intact; purchased licenses are mirrored into u.licenses and are read by the pack fallback.
    }

    const oldNav=window.navTo;
    // Create both sections as soon as the main app exists, before any click can navigate to them.
    // Economy-specific sections are created lazily when their page is opened.

    window.navTo=function(id){
      try{
        // Guarantee that the destination exists BEFORE the original navigator hides all sections.
        if(id==='kEducation' || id==='casino' || id==='autoSchool') ensureEconomySections();
      }catch(e){}
      const ret=typeof oldNav==='function'?oldNav.apply(this,arguments):undefined;
