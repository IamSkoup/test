/* ─── iOS FIXES ─────────────────────────── */
/* Prevent scroll-lock / flicker on iOS when modals open */
/* iOS modal-open: handled entirely by JS lockBodyScroll/unlockBodyScroll */
body.modal-open{/* position:fixed applied via JS */}
/* Fix backdrop-filter flicker on iOS Safari */
.g-header,.bottom-nav{-webkit-backdrop-filter:blur(20px);backdrop-filter:blur(20px);}
/* Ensure modals render on top layer on iOS */
#userProfileModal,#historyModal,#imgViewer,#videoViewer{isolation:isolate;}
    .ios-device .user-profile-sheet{-webkit-overflow-scrolling:touch;overflow-y:auto;}
    .ios-device .history-sheet{-webkit-overflow-scrolling:touch;overflow:hidden;}
    .ios-device .history-sheet-scroll{-webkit-overflow-scrolling:touch;overflow-y:scroll !important;flex:1 1 0;min-height:0;}
/* Fix touch events passing through on iOS */
#userProfileModal.open,.section.active{pointer-events:auto;}
/* Prevent double-tap zoom on buttons */
a,button,input,select,textarea,[role=button]{touch-action:manipulation;}
/* Fix video circle flicker on scroll - use contain */
.msg-video-wrap{contain:layout paint;will-change:auto;}
.msg-media-img{contain:layout paint;will-change:auto;}

/* === SAFARI iOS CHAT FIXES === */
/* Smooth scrolling in chat, no unnecessary GPU layers */
#chatMessages,#dmMessages{
    -webkit-overflow-scrolling:touch;
    overscroll-behavior:contain;
    isolation:isolate;
}
/* Fix buttons not responding in chat on Safari iOS */
#chatMessages .chat-msg,
#dmMessages .chat-msg,
#chatMessages .msg-action-btn,
#dmMessages .msg-action-btn{
    pointer-events:auto;
}
/* Ensure chat input area is always interactive */
.chat-input-row{
    position:relative;
    z-index:100;
}
.chat-input-row input,
.chat-input-row button{
    pointer-events:auto;
    -webkit-tap-highlight-color:transparent;
}
/* Fix Safari iOS double-tap and scroll issues */
@supports (-webkit-touch-callout:none){
    /* iOS: prevent auto-zoom on input focus (requires font-size >= 16px) */
    input,select{font-size:max(16px,1em);}
    /* Prevent chat flickering — backface only, no translateZ (too many GPU layers) */
    .chat-bubble{-webkit-backface-visibility:hidden;backface-visibility:hidden;}
    /* Ensure buttons work after chat entry */
    .btn,.msg-action-btn{position:relative;z-index:10;}
    /* Fix bottom nav on iPhone with safe area */
    .bottom-nav{padding-bottom:max(10px,env(safe-area-inset-bottom));}
    /* Body height */
    body{min-height:100dvh;}
}
/* Prevent momentum scrolling issues in chat */
#chatWrapper,#dmWrapper{
    -webkit-overflow-scrolling:touch;
    overscroll-behavior:contain;
}
/* Ensure emoji panel and media bar are clickable */
.emoji-panel,.media-bar,.media-bar-btn{
    pointer-events:auto;
}
/* Fix message actions appearing and buttons clickable */
.msg-actions{
    pointer-events:auto;
    display:flex;
    gap:6px;
    flex-wrap:wrap;
    align-items:center;
    justify-content:flex-end;
    max-width:min(68%,100%);
    margin-top:2px;
    opacity:0.6;
    transition:opacity .15s;
}
.chat-msg.me .msg-actions{opacity:1;}
.chat-msg.me:hover .msg-actions{opacity:1;}
