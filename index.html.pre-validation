async function notifyAllUsersOfNews(newsItem){
    const usersSnap = await get(ref(db,'users'));
    const users = usersSnap.val() || {};
    const text = `📰 Новая новость в Капани\n${newsItem.title}`;
    const jobs = Object.keys(users)
        .filter(nick => nick !== newsItem.author) // author doesn't need a notification about their own post
        .map(nick => push(notifRef(nick), { text, time: nowTime(), cat:'news', newsId: newsItem.id }).catch(()=>{}));
    await Promise.allSettled(jobs);
    try {
        await callFunctionWithFallback('sendNewsPush', { newsId:newsItem.id, title:'📰 Новая новость в Капани', body:newsItem.title, scope:newsItem.scope }, async()=>{
            // No server-side push function deployed — in-app notification above
            // already reached everyone, so this is a non-fatal no-op fallback.
