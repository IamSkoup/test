      try{ window.dbOff(window.__kapaniAdminPoliceListener.ref,'value',window.__kapaniAdminPoliceListener.fn); }catch(e){}
      window.__kapaniAdminPoliceListener=null;
    }
    const r = typeof _kapaniBaseNavTo === 'function'
