<style>
:root {
    --bg:#0c1117;--surface:rgba(255,255,255,0.04);--surface2:rgba(255,255,255,0.07);
    --border:rgba(255,255,255,0.09);--primary:#22d3a5;--pri-dim:rgba(34,211,165,0.14);
    --gold:#fbbf24;--gold-dim:rgba(251,191,36,0.14);--red:#f87171;--red-dim:rgba(248,113,113,0.14);
    --text:#e2e8f0;--muted:#64748b;--shadow:0 8px 40px rgba(0,0,0,0.5);--r:22px;--r-sm:14px;
}
*{box-sizing:border-box;margin:0;padding:0;}
body{font-family:'Nunito','Segoe UI Emoji','Apple Color Emoji','Noto Color Emoji',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;display:flex;justify-content:center;padding-bottom:80px;overflow-x:hidden;-webkit-overflow-scrolling:touch;overscroll-behavior:contain;}
.bottom-nav{-webkit-backface-visibility:hidden;backface-visibility:hidden;}
button{-webkit-tap-highlight-color:transparent;touch-action:manipulation;}
body::before{content:'';position:fixed;inset:0;pointer-events:none;z-index:0;
    background:radial-gradient(ellipse 60% 60% at 15% 25%,rgba(34,211,165,.07) 0%,transparent 70%),
               radial-gradient(ellipse 50% 50% at 85% 75%,rgba(251,191,36,.06) 0%,transparent 70%);}
.container{width:100%;max-width:490px;padding:0 12px;position:relative;z-index:1;}
.g-header{position:fixed;top:0;width:100%;max-width:490px;background:rgba(12,17,23,0.88);backdrop-filter:blur(20px);border-bottom:1px solid var(--border);height:calc(64px + env(safe-area-inset-top,0px));display:flex;align-items:center;justify-content:space-between;padding:env(safe-area-inset-top,0px) 18px 0;z-index:900;}
.h-left{display:flex;align-items:center;gap:12px;cursor:pointer;}
.h-avatar{width:40px;height:40px;border-radius:12px;object-fit:cover;border:2px solid var(--primary);transition:.2s;}
.h-avatar:hover{transform:scale(1.08);}
.h-name{font-weight:800;font-size:14px;line-height:1.2;}
.h-job{font-size:11px;color:var(--primary);font-weight:700;text-transform:uppercase;letter-spacing:.5px;}
.h-bal{background:linear-gradient(135deg,var(--primary),#0fa87e);color:#0c1117;padding:9px 16px;border-radius:12px;font-weight:900;font-size:14px;box-shadow:0 4px 14px rgba(34,211,165,.35);}
.h-notify{position:relative;cursor:pointer;font-size:22px;margin-right:4px;}
.h-badge{position:absolute;top:-4px;right:-4px;background:var(--red);color:#fff;border-radius:10px;font-size:9px;font-weight:900;padding:2px 5px;min-width:16px;text-align:center;display:none;}
.avatar-wrap{position:relative;display:inline-block;}
.online-dot{position:absolute;bottom:1px;right:1px;width:10px;height:10px;border-radius:50%;background:#22c55e;border:2px solid var(--bg);display:none;z-index:2;}
.avatar-wrap.online .online-dot{display:block;}
.av-wrap-sm{position:relative;display:block;flex-shrink:0;align-self:flex-start;}
.av-wrap-sm .online-dot{width:9px;height:9px;border-width:2px;bottom:0;right:0;}
.av-wrap-sm.online .online-dot{display:block;}
.bottom-nav{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:100%;max-width:490px;background:rgba(12,17,23,0.95);backdrop-filter:blur(20px);border-top:1px solid var(--border);display:flex;flex-direction:row;flex-wrap:nowrap;align-items:center;padding:6px 0 max(10px,env(safe-area-inset-bottom,0px));z-index:900;overflow-x:auto;overflow-y:hidden;-webkit-overflow-scrolling:touch;scrollbar-width:none;}
.bottom-nav::-webkit-scrollbar{display:none;}
.bn-item{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;background:none;border:none;color:var(--muted);font-size:8px;font-weight:800;cursor:pointer;transition:.2s;font-family:'Nunito',sans-serif;text-transform:uppercase;letter-spacing:.15px;padding:4px 3px;position:relative;line-height:1.1;flex:0 0 64px;min-width:64px;}
.bn-item[style*="display:none"]{display:none!important;flex:0!important;padding:0!important;min-width:0!important;}
.bn-item .ico{font-size:22px;transition:.2s;}
.bn-item.sel,.bn-item:hover{color:var(--primary);}
.bn-item.sel .ico{transform:scale(1.15);}
.bn-badge{position:absolute;top:0;right:8px;background:var(--red);color:#fff;border-radius:10px;font-size:9px;font-weight:900;padding:1px 5px;min-width:15px;text-align:center;display:none;}
.page-wrap{padding-top:calc(76px + env(safe-area-inset-top,0px));padding-bottom:calc(78px + env(safe-area-inset-bottom,0px));}
.section{display:none;animation:fadeUp .35s ease-out;}
.section.active{display:block;}
@keyframes fadeUp{from{opacity:0;transform:translateY(18px);}to{opacity:1;transform:translateY(0);}}
.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:20px;margin-bottom:14px;backdrop-filter:blur(12px);box-shadow:var(--shadow);transition:.2s;}
.card:hover{border-color:rgba(255,255,255,0.14);}
.card-title{font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.8px;color:var(--muted);margin-bottom:16px;}
#authSection{padding-top:20px;}
.logo-card{text-align:center;padding:40px 24px 32px;background:linear-gradient(145deg,rgba(34,211,165,.06),rgba(251,191,36,.04));border:1px solid var(--border);border-radius:var(--r);margin-bottom:14px;}
.logo-title{font-family:'Unbounded',sans-serif;font-size:38px;font-weight:900;background:linear-gradient(135deg,var(--primary),var(--gold));background-clip:text;-webkit-background-clip:text;-webkit-text-fill-color:transparent;line-height:1;}
.logo-sub{color:var(--muted);margin-top:10px;font-size:14px;}
input,textarea,select{width:100%;padding:14px 16px;margin:8px 0;background:var(--surface2);border:1px solid var(--border);border-radius:var(--r-sm);color:var(--text);font-size:15px;font-family:'Nunito',sans-serif;font-weight:600;transition:.2s;outline:none;}
input:focus,textarea:focus,select:focus{border-color:var(--primary);background:rgba(34,211,165,.06);}
textarea{resize:vertical;min-height:80px;}
select option{background:#1a2332;}
.btn{width:100%;padding:16px;border:none;border-radius:var(--r-sm);font-family:'Nunito',sans-serif;font-weight:900;font-size:14px;text-transform:uppercase;letter-spacing:.8px;cursor:pointer;transition:.2s;}
.btn:active{transform:scale(.96);}
.btn-primary{background:linear-gradient(135deg,var(--primary),#0fa87e);color:#0c1117;}
.btn-gold{background:linear-gradient(135deg,var(--gold),#d97706);color:#0c1117;}
.btn-red{background:linear-gradient(135deg,var(--red),#dc2626);color:#fff;}
.btn-ghost{background:var(--surface2);color:var(--text);border:1px solid var(--border);}
.btn-sm{padding:10px 16px;font-size:12px;width:auto;}
/* ─── GLOBAL BUTTON IMPROVEMENTS ─────────────────────── */
/* Prevent ghost-tap on iOS by using pointer-events none while disabled */
.btn:disabled{opacity:.45;cursor:not-allowed;pointer-events:none;}
/* Faster tap response on all buttons */
.btn,.bn-item,.quick-card,.msg-tab,.market-tab,.biz-tab,.news-tab{
    -webkit-tap-highlight-color:transparent;
    touch-action:manipulation;
    user-select:none;
    -webkit-user-select:none;
}
/* Reduce animation jank on low-end devices */
@media (prefers-reduced-motion: reduce) {
    .section{animation:none;}
    .quick-card:hover,.biz-card:hover{transform:none;}
}

.stats-row{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin-bottom:14px;}
.stat-box{background:var(--surface);border:1px solid var(--border);border-radius:var(--r-sm);padding:14px 12px;text-align:center;}
.stat-box .sv{font-size:20px;font-weight:900;color:var(--primary);}
.stat-box .sl{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;margin-top:2px;}
.quick-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px;}
.quick-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:20px 16px;cursor:pointer;transition:.25s;text-align:center;}
.quick-card:hover{transform:translateY(-3px);border-color:var(--primary);background:var(--pri-dim);}
.quick-card .qico{font-size:34px;margin-bottom:8px;}
.quick-card .qlbl{font-size:13px;font-weight:800;}
.quick-card .qsub{font-size:11px;color:var(--muted);margin-top:2px;}
.status-card{border-radius:var(--r);padding:18px;margin-bottom:12px;border:1px solid var(--border);}
.status-card.green{background:rgba(34,211,165,.08);border-color:rgba(34,211,165,.3);}
.status-card.gold{background:rgba(251,191,36,.08);border-color:rgba(251,191,36,.3);}
.status-badge{display:inline-flex;align-items:center;gap:6px;padding:5px 12px;border-radius:20px;font-size:10px;font-weight:900;text-transform:uppercase;letter-spacing:.5px;margin-bottom:10px;}
.badge-wait{background:var(--gold-dim);color:var(--gold);}
.badge-active{background:var(--pri-dim);color:var(--primary);}
.pulse{width:7px;height:7px;border-radius:50%;background:currentColor;animation:pulse 1.5s infinite;}
@keyframes pulse{0%{box-shadow:0 0 0 0 currentColor}100%{box-shadow:0 0 0 7px transparent}}
.item-row{display:flex;align-items:center;justify-content:space-between;padding:14px;background:var(--surface2);border-radius:var(--r-sm);margin-bottom:8px;border:1px solid var(--border);}
.item-row input{width:70px;margin:0;padding:8px;text-align:center;}
.total-row{display:flex;justify-content:space-between;align-items:center;padding:14px 16px;background:var(--pri-dim);border-radius:var(--r-sm);margin:12px 0;border:1px solid rgba(34,211,165,.25);font-weight:900;}
.cart-card,.order-card,.rent-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:16px;margin-top:12px;}
.cart-list,.order-list,.rent-list{display:flex;flex-direction:column;gap:8px;}
.cart-item,.order-item,.rent-row{display:flex;align-items:center;gap:10px;padding:12px;background:var(--surface2);border:1px solid var(--border);border-radius:var(--r-sm);}
.cart-item img,.order-item img,.rent-row img{width:54px;height:54px;border-radius:12px;object-fit:cover;flex-shrink:0;cursor:pointer;}
.cart-meta,.order-meta,.rent-meta{flex:1;min-width:0;}
.cart-title,.order-title,.rent-title{font-weight:900;font-size:14px;}
.cart-sub,.order-sub,.rent-sub{font-size:11px;color:var(--muted);margin-top:2px;line-height:1.4;}
.cart-qty{display:flex;align-items:center;gap:6px;}
.cart-qty input{width:54px;margin:0;padding:9px 8px;text-align:center;}
.cart-actions,.order-actions,.rent-actions{display:flex;flex-wrap:wrap;gap:6px;justify-content:flex-end;}
.rent-disabled{background:var(--muted)!important;border-color:var(--border)!important;color:#fff!important;opacity:.6;}
.rent-owned{background:var(--gold-dim);border:1px solid rgba(251,191,36,.25);border-radius:12px;padding:8px 10px;font-size:12px;color:var(--gold);font-weight:800;}
.biz-role-salary small{display:block;color:var(--muted);font-weight:700;margin-top:2px;}

.total-val{font-size:22px;color:var(--primary);}
.msg-tabs{display:flex;gap:8px;margin-bottom:14px;}
.msg-tab{flex:1;padding:10px;border:1px solid var(--border);border-radius:var(--r-sm);background:var(--surface);font-family:'Nunito',sans-serif;font-weight:800;font-size:13px;cursor:pointer;color:var(--muted);transition:.2s;text-align:center;touch-action:manipulation;-webkit-tap-highlight-color:transparent;}
.msg-tab.active{background:var(--pri-dim);border-color:var(--primary);color:var(--primary);}
.msg-panel{display:none;}
.msg-panel.active{display:block;}
#chatMessages,#dmMessages{height:30dvh;overflow-y:auto;display:flex;flex-direction:column;gap:8px;padding:4px 0;scrollbar-width:thin;scrollbar-color:var(--border) transparent;-webkit-overflow-scrolling:touch;overscroll-behavior:contain;position:relative;}
.chat-msg{display:flex;gap:10px;align-items:flex-start;}
.chat-msg.me{flex-direction:row-reverse;}
.chat-av{width:32px;height:32px;border-radius:10px;object-fit:cover;flex-shrink:0;display:block;}
.chat-bubble{max-width:75%;padding:10px 14px;border-radius:16px;background:var(--surface2);border:1px solid var(--border);font-size:13px;line-height:1.4;word-break:break-word;}
.chat-msg.me .chat-bubble{background:var(--pri-dim);border-color:rgba(34,211,165,.3);color:var(--primary);}
.chat-sender{font-size:10px;font-weight:900;color:var(--primary);margin-bottom:3px;text-transform:uppercase;}
.chat-time{font-size:10px;color:var(--muted);margin-top:3px;}
.chat-input-row{display:flex;gap:6px;margin-top:8px;align-items:center;}
.chat-input-row input{margin:0;flex:1;}
.dm-user-row{width:100%;text-align:left;font-family:'Nunito',sans-serif;display:flex;align-items:center;gap:12px;padding:12px 14px;background:var(--surface2);border:1px solid var(--border);border-radius:var(--r-sm);margin-bottom:8px;cursor:pointer;transition:.2s;-webkit-tap-highlight-color:transparent;touch-action:manipulation;color:var(--text);}
.dm-user-row:hover{border-color:var(--primary);background:var(--pri-dim);}
.dm-user-av{width:40px;height:40px;border-radius:12px;object-fit:cover;flex-shrink:0;}
.dm-user-info{flex:1;min-width:0;}
.dm-user-name{font-weight:800;font-size:14px;}
.dm-user-preview{font-size:11px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:2px;}
.dm-back{display:flex;align-items:center;gap:8px;cursor:pointer;color:var(--primary);font-weight:800;font-size:13px;margin-bottom:12px;background:none;border:none;padding:0;font-family:'Nunito',sans-serif;-webkit-tap-highlight-color:transparent;touch-action:manipulation;}
.dm-header-row{display:flex;align-items:center;gap:10px;padding-bottom:12px;border-bottom:1px solid var(--border);margin-bottom:12px;}
.market-tabs{display:flex;gap:8px;margin-bottom:14px;}
.market-tab{flex:1;padding:10px;border:1px solid var(--border);border-radius:var(--r-sm);background:var(--surface);font-family:'Nunito',sans-serif;font-weight:800;font-size:13px;cursor:pointer;color:var(--muted);transition:.2s;text-align:center;}
.market-tab.active{background:var(--gold-dim);border-color:var(--gold);color:var(--gold);}
.market-panel{display:none;}
.market-panel.active{display:block;}
.market-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:16px;margin-bottom:12px;transition:.2s;}
.market-card:hover{border-color:rgba(255,255,255,.14);}
.market-img{width:100%;height:180px;object-fit:cover;border-radius:var(--r-sm);margin-bottom:12px;background:var(--surface2);}
.market-title{font-weight:900;font-size:16px;margin-bottom:4px;}
.market-price{font-size:20px;font-weight:900;color:var(--gold);}
.market-desc{font-size:13px;color:var(--muted);margin:6px 0 12px;}
.market-seller{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--muted);margin-bottom:12px;}
.market-seller img{width:24px;height:24px;border-radius:8px;object-fit:cover;}
.market-status-sold{background:var(--red-dim);color:var(--red);padding:4px 10px;border-radius:8px;font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:.5px;}
.market-status-pending{background:var(--gold-dim);color:var(--gold);padding:4px 10px;border-radius:8px;font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:.5px;}
.market-status-pin{background:rgba(251,191,36,.16);color:var(--gold);padding:4px 10px;border-radius:8px;font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:.5px;}
#taxiMap{width:100%;height:320px;border-radius:var(--r-sm);overflow:hidden;margin-bottom:12px;border:1px solid var(--border);}
.taxi-point-row{display:flex;gap:8px;align-items:center;margin-bottom:8px;}
.taxi-point-row input{flex:1;margin:0;}
.taxi-point-btn{padding:12px 14px;background:var(--surface2);border:1px solid var(--border);border-radius:var(--r-sm);cursor:pointer;font-size:16px;transition:.2s;white-space:nowrap;}
.taxi-point-btn:hover{border-color:var(--primary);}
.taxi-point-btn.selecting{border-color:var(--gold);background:var(--gold-dim);}
.taxi-info-row{display:flex;gap:10px;margin-bottom:12px;}
.taxi-info-box{flex:1;background:var(--surface2);border:1px solid var(--border);border-radius:var(--r-sm);padding:12px;text-align:center;}
.taxi-info-box .tiv{font-size:18px;font-weight:900;color:var(--primary);}
.taxi-info-box .til{font-size:10px;color:var(--muted);text-transform:uppercase;margin-top:2px;}
.driver-card{background:linear-gradient(135deg,rgba(34,211,165,.1),rgba(34,211,165,.04));border:1px solid rgba(34,211,165,.3);border-radius:var(--r-sm);padding:14px;margin-bottom:12px;}
.driver-card-header{display:flex;align-items:center;gap:10px;margin-bottom:8px;}
.driver-card-av{width:44px;height:44px;border-radius:12px;object-fit:cover;border:2px solid var(--primary);}
.driver-card-name{font-weight:900;font-size:15px;}
.driver-card-vehicle{font-size:12px;color:var(--primary);margin-top:2px;}
.driver-eta{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--muted);}
.driver-eta b{color:var(--gold);font-size:18px;}
.lb-row{display:flex;align-items:center;gap:12px;padding:12px 14px;background:var(--surface);border:1px solid var(--border);border-radius:var(--r-sm);margin-bottom:8px;transition:.2s;}
.lb-rank{font-size:18px;width:28px;text-align:center;}
.lb-av{width:38px;height:38px;border-radius:11px;object-fit:cover;}
.lb-info{flex:1;}
.lb-name{font-weight:800;font-size:14px;}
.lb-job{font-size:11px;color:var(--muted);}
.lb-bal{font-weight:900;font-size:15px;color:var(--primary);}
.notif-item{display:flex;align-items:flex-start;gap:10px;padding:12px 14px;background:var(--surface);border:1px solid var(--border);border-radius:var(--r-sm);margin-bottom:8px;cursor:pointer;transition:.2s;border-left:3px solid var(--primary);}
.notif-item:hover{background:var(--pri-dim);border-left-color:var(--primary);}
.notif-text{flex:1;font-size:13px;line-height:1.4;}
.notif-time{font-size:10px;color:var(--muted);white-space:nowrap;margin-top:2px;}
.notif-del{color:var(--red);font-size:16px;opacity:.5;transition:.2s;padding-left:4px;}
.notif-item:hover .notif-del{opacity:1;}
#notifPopup{position:fixed;top:max(12px,env(safe-area-inset-top));left:50%;transform:translateX(-50%);max-width:460px;width:calc(100% - 24px);background:rgba(17,24,32,.97);backdrop-filter:blur(20px);border:1px solid var(--border);border-radius:16px;padding:14px 18px;z-index:9990;display:none;box-shadow:var(--shadow);}
