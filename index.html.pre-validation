window.sendGiftSubscription = async function(){
    const recipient = qs('giftRecipient')?.value;
    if(!recipient) return toast('⚠️ Выберите получателя', 'gold');
    if(!giftSubscriptionType) return;
    
    const price = getSubscriptionPrice(giftSubscriptionType);
    const name = CONFIG.subscriptions[giftSubscriptionType].name;
    
    // Check giver's balance
    const giverSnap = await get(userRef(currentNick));
    const giver = giverSnap.val();
    if(!giver || (giver.balance || 0) < price) {
        return toast(`❌ Недостаточно средств. Нужно ${price}₽`, 'red');
    }
    
    // Check recipient exists
    const recipientSnap = await get(userRef(recipient));
    if(!recipientSnap.exists()) {
        return toast('❌ Получатель не найден', 'red');
    }
    const recipientUser = recipientSnap.val();
    
    // Calculate expiry (extend if already has active subscription)
    const now = new Date();
    const currentExpiry = recipientUser.subscriptionExpiry ? new Date(recipientUser.subscriptionExpiry) : null;
    const hasActiveSameType = currentExpiry && currentExpiry > now && recipientUser.subscription === giftSubscriptionType;
    
    let expiry, startDate;
    if(hasActiveSameType) {
        expiry = new Date(currentExpiry.getTime() + 7 * 24 * 60 * 60 * 1000);
        startDate = recipientUser.subscriptionStart || now.toISOString();
    } else {
        expiry = new Date(now.getTime() + 7 * 24 * 60 * 60 * 1000);
        startDate = now.toISOString();
    }
    
    if(!confirm(`Подарить ${name} пользователю ${recipient} за ${price}₽?`)) return;
    
    // Deduct from giver
    await update(userRef(currentNick), { balance: (giver.balance || 0) - price });
    
    // Apply to recipient
    await update(userRef(recipient), {
        subscription: giftSubscriptionType,
        subscriptionStatus: 'active',
        subscriptionExpiry: expiry.toISOString(),
        subscriptionStart: startDate,
        subscriptionGiftedBy: currentNick,
        subscriptionGiftedAt: now.toISOString()
    });
    await window.addMunicipalTreasury?.(price, `Подаренная подписка ${name} от ${currentNick}`, {sourceNick:currentNick,sourceType:'subscription_gift'});
    
    // Log transactions
    await logTx(currentNick, {
        type: 'out',
        who: 'Подарок подписки',
        amt: price,
        desc: `Подарок ${name} для ${recipient}`
    });
    
    // Send notifications
    await pushNotification(currentNick, `🎁 Вы подарили ${name} пользователю ${recipient}!`, 'system');
    await pushNotification(recipient, `🎁 ${currentNick} подарил вам ${name}!`, 'system');
    const giftDm = {
        nick: currentNick,
        avatar: giver.avatar || DEFAULT_AVATAR_URL,
        text: `🎁 ${name} в подарок`,
        msgType: 'gift_subscription',
        time: nowTime(),
        createdAt: Date.now()
    };
    await push(dmRef(dmKey(currentNick, recipient)), giftDm);
    
    toast(`🎁 ${name} подарен ${recipient}!`, 'green');
    closeGiftSubscriptionModal();
    
    // Update header balance
    updateHeader_balance({...giver, balance: (giver.balance || 0) - price});
};

