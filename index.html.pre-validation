async function notifyAllUsersOfChatMessage(msg){
    if(!msg || !msg.nick || msg.nick===currentNick) return;
    const preview=chatNotificationPreview(msg);
    const fingerprint=`${msg.nick}|${preview}`;
    const now=Date.now();
    if(_chatNotifyDedupe[fingerprint] && now-_chatNotifyDedupe[fingerprint] < 30000) return;
    _chatNotifyDedupe[fingerprint]=now;
    const usersSnap=await get(ref(db,'users'));
    const users=usersSnap.val()||{};
    const sender=users[msg.nick] || allUsersCache[msg.nick] || {};
    const senderName=displayNick(sender) || msg.nick;
    const text=`💬 ${senderName} написал в общий чат: ${preview}`;
    const jobs=Object.keys(users)
        .filter(nick=>nick!==msg.nick)
        .map(nick=>pushNotification(nick,text,'messages').catch(()=>{}));
    await Promise.allSettled(jobs);
}
