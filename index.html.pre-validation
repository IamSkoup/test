        const fn = httpsCallable(await ensureFunctions(), functionName);
        const result = await fn(data);
        return result.data;
    } catch (error) {
        console.warn(`Cloud Function ${functionName} failed, using fallback:`, error.message);
        if(fallbackFn) {
            return await fallbackFn(data);
        }
        throw error;
    }
}

