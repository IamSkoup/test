function getPushPrefs(){try{return JSON.parse(localStorage.getItem('kp_push')||'{}');}catch(e){return{};}}
function savePushPrefs(p){try{localStorage.setItem('kp_push',JSON.stringify(p));}catch(e){}}
function isPushOn(){const p=getPushPrefs();return p.enabled!==false;}
function isPushCatEnabled(cat){if(!isPushOn())return false;const p=getPushPrefs();return p[cat]!==false;}
let _swReg=null;
// Detect Safari/iOS for notifications
function isSafariBrowser(){
    const ua = navigator.userAgent || '';
    return /Safari\//.test(ua) && !/Chrome\/|CriOS\/|FxiOS\/|OPiOS\//.test(ua);
}
function isIOSDevice(){
    const ua = navigator.userAgent || '';
    return /iP(hone|od|ad)/.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
}
function isIOSPWA(){
    return (window.navigator.standalone === true) || window.matchMedia('(display-mode: standalone)').matches;
}
async function getSwReg(){
    if(_swReg) return _swReg;
    if(location.protocol === 'file:') return null;
    if(!('serviceWorker' in navigator)) return null;
    try {
        const swUrl = new URL('firebase-messaging-sw.js', location.href).href;
        _swReg = await navigator.serviceWorker.register(swUrl, { scope: './' });
        try { await navigator.serviceWorker.ready; } catch(e) {}
        return _swReg;
    } catch(err){console.warn('SW register failed:',err);return null;}
}
async function requestNotificationPermission(){
    // Cross-browser permission request — handles old Safari callback API and modern Promise API
    if(!('Notification' in window)) return 'unsupported';
    if(Notification.permission === 'granted') return 'granted';
    if(Notification.permission === 'denied') return 'denied';
    try {
        // Modern browsers: returns a Promise
        const result = await Notification.requestPermission();
        return result;
    } catch(e) {
        // Older Safari: requestPermission only supports callback
        return new Promise(resolve => {
            try { Notification.requestPermission(resolve); }
            catch(e2) { resolve('denied'); }
        });
    }
}
async function requestPushPermission(){
    if(!('Notification' in window)) return false;
    // iOS Safari < 16.4: No web push support unless added to home screen
    if(isIOSDevice() && !isIOSPWA()){
        const majorVer = parseInt((navigator.userAgent.match(/OS (\d+)_/)||[])[1]||'0', 10);
        if(majorVer < 16){
            toast('📲 iOS не поддерживает уведомления в браузере. Добавьте сайт на главный экран.','gold');
            return false;
        }
        // iOS 16.4+: only works as installed PWA
        toast('📲 Для уведомлений добавьте сайт на главный экран iPhone (Поделиться → На экран «Домой»)','gold');
        return false;
    }
    if(Notification.permission==='granted'){await tryRegisterFcm();return true;}
    if(Notification.permission==='denied') return false;
    const result = await requestNotificationPermission();
    if(result==='granted'){const p=getPushPrefs();p.enabled=true;savePushPrefs(p);await getSwReg();await tryRegisterFcm();toast('🔔 Push-уведомления включены!','green');return true;}
    return false;
}
async function tryRegisterFcm(){
    if(!FCM_VAPID_KEY||!currentNick)return;
    try{
        const pack = await ensureMessaging();
        if(!pack.messaging) return;
        const { getToken, onMessage } = pack.mod;
        const reg=await getSwReg();
        if(!reg) return;
        const token=await getToken(pack.messaging,{vapidKey:FCM_VAPID_KEY,serviceWorkerRegistration:reg});
        if(token)await update(userRef(currentNick),{fcmToken:token,fcmUpdatedAt:Date.now()});
        onMessage(pack.messaging,(payload)=>{const t=payload.notification?.title||'Капани';const b=payload.notification?.body||'';if(b)toast('🔔 '+b,'green');});
    }catch(e){console.warn('FCM',e);}
}
async function sendPushNotification(title,body,cat){
    cat=cat||'system';
    if(!('Notification' in window)||Notification.permission!=='granted') return;
    if(!isPushCatEnabled(cat)) return;
    // iOS Safari PWA: only send if installed as PWA
    if(isIOSDevice() && !isIOSPWA()) return;
    try{
        const reg = await getSwReg();
        if(reg && typeof reg.showNotification === 'function'){
            await reg.showNotification(title,{body,icon:'https://cdn-icons-png.flaticon.com/512/149/149071.png',badge:'https://cdn-icons-png.flaticon.com/512/149/149071.png',vibrate:[200,80,200],tag:'kapani-'+cat,renotify:true});
            return;
        }
    }catch(e){}
    try{new Notification(title,{body,icon:'https://cdn-icons-png.flaticon.com/512/149/149071.png',tag:'kapani-'+cat});}catch(e){}
}
