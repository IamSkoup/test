window.changeDisplayName=async function(){
    const oldNick = currentNick;
    const snap = await get(userRef(oldNick));
    if(!snap.exists()) return;
    const u = snap.val() || {};
    const cur = displayNick(u) || oldNick;
    const v = prompt('Ваше отображаемое имя в Капани (для входа и переводов):',cur);
    if(v===null) return;
    const t = v.trim().slice(0,40);
    if(!t) return toast('⚠️ Имя не может быть пустым','gold');

    const dup = await findUserByPublicName(t);
    if(dup && dup.nick !== oldNick) return toast('❌ Это имя уже занято','red');

    const newNick = makeNickFromName(t);
    // Keep the storage key stable when the generated nickname would collide or
    // differ only by unsupported characters. Otherwise migrate users/<nick>.
    let targetNick = newNick || oldNick;
    if(targetNick !== oldNick){
        const existingTarget = await get(userRef(targetNick));
        if(existingTarget.exists()) return toast('❌ Такой ник уже занят','red');
    } else {
        targetNick = oldNick;
    }

    const patch = {
        displayName: t,
        nick: targetNick,
        passwordHashSalt: u.passwordHashSalt || oldNick
    };

    if(targetNick === oldNick){
        await update(userRef(oldNick), patch);
    } else {
        // Rename the complete users/<oldNick> record so Firebase's visible
        // users/ key and the user's `nick` field stay in sync.
        const migrated = { ...u, ...patch };
        await set(userRef(targetNick), migrated);
        await remove(userRef(oldNick));

        // Migrate the most important nick-keyed/user-owned branches.
        const branchTasks = [
            ['walls', false],
            ['txLog', false]
        ];
        for(const [branch] of branchTasks){
            try{
                const oldRef = ref(db, `${branch}/${oldNick}`);
                const oldBranch = await get(oldRef);
                if(oldBranch.exists()){
                    await set(ref(db, `${branch}/${targetNick}`), oldBranch.val());
                    await remove(oldRef);
                }
            }catch(e){ console.warn(`[Kapani] ${branch} nick migration:`,e); }
        }

        try {
            const bizSnap = await get(ref(db,'businesses'));
            const businesses = bizSnap.val() || {};
            for(const [bid,biz] of Object.entries(businesses)){
                if(!biz || !biz.employees || !Object.prototype.hasOwnProperty.call(biz.employees, oldNick)) continue;
                const emp = biz.employees[oldNick];
                const nextBiz = {...biz, employees:{...biz.employees}};
                delete nextBiz.employees[oldNick];
                nextBiz.employees[targetNick] = emp;
                await update(ref(db,`businesses/${bid}`), { employees: nextBiz.employees });
            }
        } catch(e){ console.warn('[Kapani] business nick migration:',e); }
    }

    // Update local identity immediately so the SPA does not require reload.
    currentNick = targetNick;
    syncCurrentNick();
    localStorage.setItem('kp_s', targetNick);
    sessionStorage.setItem('kp_s', targetNick);
    try{
        const auth = JSON.parse(localStorage.getItem('kp_auth') || 'null') || {};
        localStorage.setItem('kp_auth', JSON.stringify({...auth, nick:targetNick, name:t, displayName:t}));
    }catch(e){}

    // Rebind realtime listeners from users/<oldNick> to users/<newNick>.
    try{
        if(targetNick !== oldNick){
            Object.values(listeners || {}).forEach(({ref:r,fn})=>{ try{ off(r,'value',fn); }catch(e){} });
            listeners = {};
            if(dmListeners.current){ try{ off(dmListeners.current.ref,'value',dmListeners.current.fn); }catch(e){} }
            if(dmListeners.read){ try{ off(dmListeners.read.ref,'value',dmListeners.read.fn); }catch(e){} }
            dmListeners = {};
            attachListeners();
        }
    }catch(e){ console.warn('[Kapani] listener rebind after nick change:',e); }

    const fresh = {...u, ...patch};
    allUsersCache[targetNick] = fresh;
    if(oldNick !== targetNick) delete allUsersCache[oldNick];
    window.allUsersCache = allUsersCache;
    updateHeader(fresh);
    toast('✅ Имя, nick и запись users/ обновлены','green');
};
