.chat-date-separator{display:flex;align-items:center;justify-content:center;margin:10px 0;gap:8px;}
.chat-date-separator span{font-size:11px;font-weight:800;color:var(--muted);background:var(--surface2);border:1px solid var(--border);border-radius:20px;padding:3px 12px;white-space:nowrap;}
