function renderHospitalPanelFinance(appts,doctorNick){
    const el=qs('hospitalPanelFinance');if(!el)return;
    if(!doctorNick){el.innerHTML='<div style="color:var(--muted);font-size:13px;">Нет назначенного врача.</div>';return;}
