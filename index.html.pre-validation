  // ─── FIX STALE pointer-events AFTER HIDDEN OVERLAYS ────────────────
  // iOS bug: when an overlay is hidden its pointer-events block can persist
  const clearBlockingLayers = () => {
    ['loadingOverlay','notifPopup'].forEach(id => {
      const el = document.getElementById(id);
      if(el && el.classList.contains('show')) return; // currently visible — leave pointer-events alone
      if(el && getComputedStyle(el).display === 'none'){
        el.style.pointerEvents = 'none';
      }
    });
    // Also ensure closed modals don't block.
    // Check classList.contains('open') — NOT display style — because display:none
    // is applied 350ms after 'open' class is removed (animation delay). Checking
    // display would miss the 0–350ms window where modal is invisible but
    // pointer-events:none hasn't been applied yet, blocking all taps below.
    ['userProfileModal','historyModal','imgViewer','videoViewer','vcModal'].forEach(id => {
      const el = document.getElementById(id);
      if(el && !el.classList.contains('open')){
        el.style.pointerEvents = 'none';
      }
    });
  };
  window.addEventListener('pageshow', clearBlockingLayers);
  window.addEventListener('focus', clearBlockingLayers);
  document.addEventListener('visibilitychange', clearBlockingLayers);
  setTimeout(clearBlockingLayers, 300);
  /* removed periodic clearBlockingLayers — caused recurring style writes that interacted badly with iOS scroll containers */

  // ─── FIX MODAL OPEN/CLOSE POINTER EVENTS ────────────────────────
  // Monkey-patch openUserProfile and closeUserProfile to ensure pointer-events are correct
