async function pushNotification(nick,text,cat='system'){
    try{
        const notificationRef = push(notifRef(nick));
        const notificationId = notificationRef.key;

        await set(notificationRef,{
            text,
            time:nowTime(),
            cat,
            createdAt:Date.now(),
            pushBridgeProcessedAt:null
        });

        const bridgeUrl = globalThis.KAPANI_CONFIG?.pushBridgeUrl;
        if(bridgeUrl && notificationId){
            fetch(`${bridgeUrl}/push`,{
                method:'POST',
                headers:{'Content-Type':'application/json'},
                body:JSON.stringify({
                    nick,
                    notificationId
                })
