};

window.wdBuyHint2=async function(){
  const snap=await get(userRef(currentNick));const u=snap.val()||{};
  if((u.balance||0)<10) return toast('❌ Нужно 10₽','red');
  await update(userRef(currentNick),{balance:(u.balance||0)-10});
