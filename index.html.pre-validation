    if(txt) return txt.length>80 ? txt.slice(0,77)+'...' : txt;
    if(msg.msgType==='image') return '📷 Фото';
    if(msg.msgType==='voice') return '🎤 Голосовое сообщение';
    if(msg.msgType==='video') return '🎬 Видео';
    if(msg.msgType==='video_circle') return '⭕ Видеосообщение';
