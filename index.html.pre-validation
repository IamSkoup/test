@keyframes primeBubbleShift{0%{background-position:0% 50%;}50%{background-position:100% 50%;}100%{background-position:0% 50%;}}

/* Interface Themes */
.theme-gold{--primary:#fbbf24;--pri-dim:rgba(251,191,36,.14);}
.theme-gold .h-bal{background:linear-gradient(135deg,var(--gold),#d97706)!important;}
.theme-gold .btn-primary{background:linear-gradient(135deg,var(--gold),#d97706)!important;color:#0c1117!important;}
.theme-gold .h-avatar{border-color:var(--gold)!important;}
.theme-gold .chat-msg.me .chat-bubble{background:rgba(251,191,36,.1)!important;border-color:rgba(251,191,36,.3)!important;}
/* Kapani Prime Interface Theme - shimmering animated colors */
.theme-prime{--primary:#f0c419;--pri-dim:rgba(240,196,25,.14);}
.theme-prime .h-bal{background:var(--gold)!important;color:#0c1117!important;}
.theme-prime .btn-primary{background:var(--gold)!important;color:#0c1117!important;}
.theme-prime .h-avatar{border-color:#f0c419!important;box-shadow:0 0 15px rgba(240,196,25,.5)!important;}
.theme-prime .chat-msg.me .chat-bubble{background:rgba(240,196,25,.15)!important;border-color:rgba(240,196,25,.4)!important;}
@keyframes primeGradientShift{0%{background-position:0% 50%;}50%{background-position:100% 50%;}100%{background-position:0% 50%;}}
@keyframes primeThemeShift{0%,100%{filter:hue-rotate(0deg);}50%{filter:hue-rotate(15deg);}}

/* === GAMES LIBRARY === */
#gamesGrid .card{transition:.2s;}
#gamesGrid .card:hover{transform:translateY(-3px);}
#hospitalPhotosGallery img,#hospitalPanelPhotos img{transition:.2s;}
#hospitalPhotosGallery img:hover,#hospitalPanelPhotos img:hover{transform:scale(1.02);}


.sub-badge-plus{display:inline-block;background:linear-gradient(135deg,var(--gold),#d97706);color:#000;padding:4px 12px;border-radius:20px;font-weight:900;}
.sub-badge-ultra{display:inline-block;background:linear-gradient(135deg,#22d3a5,#0d9488);color:#000;padding:4px 12px;border-radius:20px;font-weight:900;animation:pulseUltra 2s ease-in-out infinite;}
@keyframes pulseUltra{0%,100%{transform:scale(1);}50%{transform:scale(1.05);}}
.sub-badge-prime{display:inline-block;background:var(--gold-dim);border:1px solid rgba(251,191,36,.3);color:var(--gold);padding:4px 12px;border-radius:20px;font-weight:900;}

/* Info modal rows */
.info-row{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid var(--border);font-size:13px;}
.info-row:last-child{border-bottom:none;}
.info-tab-content ul{margin:0 0 10px 18px;padding:0;display:flex;flex-direction:column;gap:4px;font-size:13px;line-height:1.5;}

/* iPhone Fix - Enhanced Performance (iOS-safe; aggressive GPU hacks removed — they break tap hit-testing on iOS 16+) */
body{-webkit-overflow-scrolling:touch;touch-action:manipulation;-webkit-font-smoothing:antialiased;-webkit-text-size-adjust:100%;}
.section{}
button,.btn,a,[onclick],[role="button"]{-webkit-tap-highlight-color:transparent;touch-action:manipulation;cursor:pointer;}
input,textarea,select{-webkit-appearance:none;appearance:none;-webkit-tap-highlight-color:transparent;border-radius:0;font-size:16px;}
input[type="checkbox"]{-webkit-appearance:checkbox;appearance:checkbox;width:16px;height:16px;margin:0;cursor:pointer;}
.avatar-frame{pointer-events:none;}
#userProfileModal{position:fixed;inset:0;background:rgba(0,0,0,.75);z-index:9985;display:none;align-items:flex-end;justify-content:center;-webkit-overflow-scrolling:touch;}
#userProfileModal.open{display:flex;}
.user-profile-sheet{-webkit-overflow-scrolling:touch;overflow-y:auto;max-height:90vh;overscroll-behavior:contain;}
.user-profile-sheet{background:#131b24;border-radius:24px 24px 0 0;width:100%;max-width:490px;max-height:80vh;overflow-y:auto;padding:24px 18px 44px;animation:sheetUp .3s ease-out;}
.upm-online{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:800;margin-top:6px;}
.upm-online.is-online{color:#22c55e;}
.upm-online.is-offline{color:var(--muted);}
.upm-dot{width:8px;height:8px;border-radius:50%;background:currentColor;}
#loadingOverlay{
    position:fixed;inset:0;
    background:var(--bg);
    z-index:9999;
    display:flex;flex-direction:column;align-items:center;justify-content:center;
    gap:0;
    transition:opacity .4s ease, visibility .4s ease;
}
#loadingOverlay.hidden{opacity:0;visibility:hidden;pointer-events:none;}
#loadingOverlay .lo-logo{
    width:88px;height:88px;border-radius:28px;
    background:linear-gradient(135deg,var(--primary),#1ab8cc);
    display:flex;align-items:center;justify-content:center;
    font-size:44px;
    box-shadow:0 8px 40px rgba(34,211,165,.35);
    margin-bottom:28px;
    animation:loPulse 2s ease-in-out infinite;
}
@keyframes loPulse{0%,100%{box-shadow:0 8px 40px rgba(34,211,165,.35);}50%{box-shadow:0 8px 60px rgba(34,211,165,.65);}}
#loadingOverlay .lo-title{
    font-family:'Unbounded',sans-serif;font-size:26px;font-weight:900;
    color:var(--text);letter-spacing:-.5px;margin-bottom:4px;
}
#loadingOverlay .lo-sub{
    font-size:13px;color:var(--muted);font-weight:600;
    margin-bottom:36px;
}
#loadingOverlay .lo-bar-wrap{
    width:200px;height:4px;background:var(--border);border-radius:4px;overflow:hidden;
    margin-bottom:20px;
}
#loadingOverlay .lo-bar{
    height:100%;width:0%;border-radius:4px;
    background:linear-gradient(90deg,var(--primary),#1ab8cc);
    animation:loBar 1.4s cubic-bezier(.4,0,.2,1) forwards;
}
@keyframes loBar{0%{width:0%}60%{width:75%}90%{width:92%}100%{width:92%}}
#loadingOverlay .lo-status{
    font-size:12px;color:var(--muted);font-weight:600;letter-spacing:.3px;
    animation:loFade 1.4s ease-in-out infinite alternate;
}
@keyframes loFade{from{opacity:.5}to{opacity:1}}
.spinner{width:40px;height:40px;border:3px solid var(--border);border-top-color:var(--primary);border-radius:50%;animation:spin .8s linear infinite;}
@keyframes spin{to{transform:rotate(360deg)}}
#toasts{position:fixed;top:84px;right:12px;bottom:auto;width:340px;max-width:calc(100% - 24px);z-index:9999;padding-right:0;pointer-events:none;}
.toast{display:flex;align-items:center;gap:12px;margin-bottom:8px;padding:14px 18px;background:rgba(17,24,32,.96);backdrop-filter:blur(16px);border:1px solid var(--border);border-radius:16px;box-shadow:var(--shadow);animation:toastIn .3s ease-out;font-size:14px;font-weight:700;pointer-events:auto;}
.toast.green{border-left:3px solid var(--primary);}
.toast.gold{border-left:3px solid var(--gold);}
.toast.red{border-left:3px solid var(--red);}
@keyframes toastIn{from{opacity:0;transform:translateX(40px);}to{opacity:1;transform:translateX(0);}}
::-webkit-scrollbar{width:5px;}
::-webkit-scrollbar-track{background:transparent;}
::-webkit-scrollbar-thumb{background:var(--border);border-radius:10px;}
#shopMap{width:100%;height:260px;border-radius:var(--r-sm);overflow:hidden;margin-bottom:8px;border:1px solid var(--border);display:none;}
#shopMap.visible{display:block;}
.toggle-map-btn{background:var(--surface2);border:1px solid var(--border);border-radius:var(--r-sm);padding:10px 14px;font-family:'Nunito',sans-serif;font-weight:800;font-size:12px;color:var(--primary);cursor:pointer;width:100%;transition:.2s;text-align:center;}
.toggle-map-btn:hover{background:var(--pri-dim);}
.msg-actions{display:flex;gap:6px;margin-top:5px;justify-content:flex-end;opacity:.55;transition:opacity .2s;}
.chat-msg.me:hover .msg-actions,.chat-msg.me:active .msg-actions,.chat-msg.me .msg-actions{opacity:1;}
.msg-action-btn{background:var(--surface2);border:1px solid var(--border);border-radius:8px;padding:3px 10px;font-size:11px;cursor:pointer;transition:.2s;font-family:'Nunito',sans-serif;font-weight:800;color:var(--text);}
.msg-action-btn:hover{border-color:var(--primary);color:var(--primary);}
.msg-edit-area{display:none;margin-top:6px;}
.msg-edit-area textarea{min-height:50px;font-size:13px;margin:0 0 4px;}
.msg-edit-area .edit-btns{display:flex;gap:6px;}
#historyModal{position:fixed;inset:0;background:rgba(0,0,0,.72);z-index:9980;display:none;align-items:flex-end;justify-content:center;}
#historyModal.open{display:flex;}
.history-sheet{background:#131b24;border-radius:24px 24px 0 0;width:100%;max-width:490px;height:min(72vh,640px);max-height:min(72vh,640px);display:flex;flex-direction:column;overflow:hidden;padding:24px 18px max(28px,env(safe-area-inset-bottom));animation:sheetUp .3s ease-out;box-sizing:border-box;position:relative;}
.history-sheet-scroll{flex:1 1 0;min-height:0;overflow-y:auto;-webkit-overflow-scrolling:touch;overscroll-behavior:contain;padding-right:2px;}
.history-close{position:absolute;top:18px;right:18px;width:32px;height:32px;display:flex;align-items:center;justify-content:center;border-radius:50%;background:var(--surface2);color:var(--text);font-size:16px;cursor:pointer;z-index:10;border:none;line-height:1;flex-shrink:0;}
.delivery-order-grid{display:grid;grid-template-columns:1fr;gap:10px;margin-top:10px;}
.delivery-choice-box{background:var(--surface2);border:1px solid var(--border);border-radius:var(--r-sm);padding:12px;}
.delivery-choice-label{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;font-weight:800;margin-bottom:6px;}
.delivery-choice-note{font-size:12px;color:var(--muted);line-height:1.45;margin-top:6px;}
.delivery-summary{margin-top:10px;padding:12px 14px;border-radius:var(--r-sm);background:rgba(34,211,165,.08);border:1px solid rgba(34,211,165,.22);font-size:13px;line-height:1.45;}
@keyframes sheetUp{from{transform:translateY(100%);}to{transform:translateY(0);}}
.history-close{font-size:22px;cursor:pointer;color:var(--muted);}
.history-summary{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:18px;}
.history-sum-box{padding:14px;border-radius:var(--r-sm);text-align:center;}
.history-sum-box.income{background:rgba(34,211,165,.12);border:1px solid rgba(34,211,165,.3);}
.history-sum-box.expense{background:rgba(248,113,113,.12);border:1px solid rgba(248,113,113,.3);}
.history-sum-val{font-size:22px;font-weight:900;}
.history-sum-lbl{font-size:10px;color:var(--muted);text-transform:uppercase;margin-top:2px;}
.tx-item{display:flex;align-items:flex-start;gap:10px;padding:12px 0;border-bottom:1px solid var(--border);}
.tx-item:last-child{border-bottom:none;}
.tx-ico{font-size:20px;flex-shrink:0;}
.tx-info{flex:1;min-width:0;}
.tx-who{font-weight:800;font-size:13px;}
.tx-what{font-size:11px;color:var(--muted);margin-top:1px;}
.tx-amt{font-weight:900;font-size:15px;white-space:nowrap;}
.tx-amt.plus{color:var(--primary);}
.tx-amt.minus{color:var(--red);}
.file-upload-btn{display:flex;align-items:center;justify-content:center;gap:6px;background:var(--surface2);border:1px solid var(--border);border-radius:var(--r-sm);padding:12px 16px;font-family:'Nunito',sans-serif;font-weight:800;font-size:12px;cursor:pointer;transition:.2s;color:var(--text);}
.file-upload-btn:hover{border-color:var(--primary);background:var(--pri-dim);color:var(--primary);}
input[type=file]{display:none;}
#trackingMap,#driverTrackMap{width:100%;height:320px;border-radius:var(--r-sm);overflow:hidden;border:1px solid var(--border);}
.tracking-card{background:var(--surface);border:1px solid rgba(34,211,165,.3);border-radius:var(--r);padding:16px;margin-bottom:14px;}
.tracking-live{display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:900;color:var(--primary);text-transform:uppercase;letter-spacing:.5px;margin-bottom:10px;}

/* === EMOJI PICKER === */
.emoji-panel{display:none;max-height:180px;overflow-y:auto;margin-bottom:8px;border:1px solid var(--border);border-radius:var(--r-sm);padding:8px;background:var(--surface2);animation:fadeUp .2s ease-out;scrollbar-width:thin;}
.emoji-panel.open{display:block;}
.emoji-grid{display:grid;grid-template-columns:repeat(10,1fr);gap:1px;}
.ep-btn{background:none;border:none;font-size:20px;cursor:pointer;border-radius:6px;padding:4px 2px;transition:.15s;line-height:1.1;text-align:center;width:100%;}
.ep-btn:hover{background:var(--surface);}

/* === MEDIA BAR === */
.media-ico-btn{background:var(--surface2);border:1px solid var(--border);border-radius:10px;padding:8px 10px;font-size:18px;cursor:pointer;transition:.2s;flex-shrink:0;line-height:1;}
.media-ico-btn:hover{background:var(--pri-dim);border-color:var(--primary);}
.media-bar{display:none;gap:8px;margin-bottom:8px;flex-wrap:wrap;animation:fadeUp .2s ease-out;}
.media-bar.open{display:flex;}
.media-bar-btn{display:flex;align-items:center;gap:6px;background:var(--surface2);border:1px solid var(--border);border-radius:var(--r-sm);padding:9px 14px;font-family:'Nunito',sans-serif;font-weight:800;font-size:12px;cursor:pointer;transition:.2s;color:var(--text);}
.media-bar-btn:hover{border-color:var(--primary);background:var(--pri-dim);color:var(--primary);}

/* === RECORDING === */
.rec-indicator{display:none;align-items:center;gap:8px;padding:10px 14px;background:var(--red-dim);border:1px solid rgba(248,113,113,.4);border-radius:var(--r-sm);margin-bottom:8px;animation:fadeUp .2s ease-out;}
.rec-indicator.show{display:flex;}
.rec-dot-anim{width:10px;height:10px;border-radius:50%;background:var(--red);flex-shrink:0;animation:pulse 1s infinite;}
.rec-timer-txt{font-weight:900;font-size:14px;color:var(--red);font-variant-numeric:tabular-nums;}
.rec-stop-btn{margin-left:auto;background:var(--red);border:none;border-radius:8px;color:#fff;font-family:'Nunito',sans-serif;font-weight:900;font-size:12px;padding:6px 12px;cursor:pointer;transition:.2s;}
.rec-stop-btn:hover{background:#dc2626;}
.rec-cancel-btn{background:none;border:none;color:var(--muted);font-size:18px;cursor:pointer;padding:4px;transition:.2s;}
.rec-cancel-btn:hover{color:var(--red);}

/* === VIDEO CIRCLE MODAL === */
#vcModal{position:fixed;inset:0;background:rgba(0,0,0,.96);z-index:9990;display:none;flex-direction:column;align-items:center;justify-content:center;gap:20px;}
#vcModal.open{display:flex;animation:fadeUp .25s ease-out;}
.vc-circle{position:relative;width:240px;height:240px;border-radius:50%;overflow:hidden;border:3px solid var(--primary);box-shadow:0 0 0 8px var(--pri-dim),0 8px 40px rgba(34,211,165,.3);flex-shrink:0;background:#000;}
.vc-circle video{width:100%;height:100%;object-fit:cover;display:block;}
/* Live video: front camera mirrors (selfie style), back camera doesn't */
#vcLiveVid{transform:scaleX(-1);-webkit-transform:scaleX(-1);}
#vcLiveVid[data-facing="environment"]{transform:scaleX(1);-webkit-transform:scaleX(1);}
/* Playback video: NEVER mirror - shows exactly as recorded */
#vcPlaybackVid{transform:scaleX(1) !important;-webkit-transform:scaleX(1) !important;object-fit:cover !important;width:100% !important;height:100% !important;}
.vc-timer-badge{position:absolute;bottom:12px;left:50%;transform:translateX(-50%);background:rgba(0,0,0,.75);color:#fff;font-weight:900;font-size:13px;padding:3px 12px;border-radius:10px;white-space:nowrap;display:none;}
.vc-rec-btn{width:72px;height:72px;border-radius:50%;border:4px solid rgba(255,255,255,.25);font-size:28px;cursor:pointer;background:var(--red);color:#fff;box-shadow:0 4px 20px rgba(248,113,113,.5);transition:.2s;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.vc-rec-btn.is-rec{box-shadow:0 0 0 8px rgba(220,38,38,.3);animation:pulse 1s infinite;}
.vc-hint{color:rgba(255,255,255,.55);font-size:12px;font-weight:700;text-align:center;max-width:200px;}
.vc-close-btn{position:absolute;top:18px;right:18px;background:rgba(255,255,255,.1);border:none;border-radius:50%;width:40px;height:40px;font-size:20px;cursor:pointer;color:#fff;display:flex;align-items:center;justify-content:center;transition:.2s;}
.vc-close-btn:hover{background:rgba(255,255,255,.2);}
.vc-send-row{display:none;gap:12px;flex-wrap:wrap;justify-content:center;}
.vc-send-row.show{display:flex;}
.vc-action-btn{padding:12px 22px;border:none;border-radius:12px;font-family:'Nunito',sans-serif;font-weight:900;font-size:13px;cursor:pointer;transition:.2s;}
.vc-action-btn:active{transform:scale(.95);}

/* === MEDIA IN MESSAGES === */
.msg-media-img{max-width:210px;max-height:210px;border-radius:12px;cursor:pointer;display:block;object-fit:cover;margin-top:4px;}
.vc-play-overlay{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.28);font-size:28px;color:#fff;transition:.2s;}
.vc-play-overlay:hover{background:rgba(0,0,0,.4);}
.chat-audio-player{display:flex;align-items:center;gap:8px;padding:4px 0;margin-top:4px;}
.chat-audio-player audio{height:32px;min-width:120px;max-width:170px;flex:1;}
.chat-bubble{display:flex;flex-direction:column;align-items:flex-start;gap:6px;max-width:75%;min-width:0;overflow:hidden;}
.chat-bubble .chat-time{align-self:flex-start;}
.chat-msg.me .chat-bubble{align-items:flex-end;}
.msg-media-wrap{display:block;max-width:100%;overflow:hidden;border-radius:12px;}
.msg-media-wrap.msg-media-circle{border-radius:999px;overflow:visible;display:inline-block;max-width:none;}
.msg-media-img{max-width:100%;width:100%;height:auto;max-height:260px;border-radius:12px;cursor:pointer;display:block;object-fit:cover;margin-top:4px;}
.msg-media-video{max-width:100%;width:100%;height:auto;max-height:260px;border-radius:12px;display:block;margin-top:4px;}
/* Video message circle - NEVER mirror */
.msg-video-wrap{position:relative;width:min(180px,100%);aspect-ratio:1/1;border-radius:50%;overflow:hidden;border:2px solid var(--primary);cursor:pointer;margin-top:4px;}
.msg-video-wrap video{width:100%;height:100%;object-fit:cover;display:block;max-height:none !important;transform:scaleX(1) !important;-webkit-transform:scaleX(1) !important;}
.chat-audio-player{display:flex;align-items:center;gap:8px;padding:2px 0;margin-top:4px;width:100%;max-width:100%;}
.media-queue{display:none;flex-direction:column;gap:8px;margin:8px 0 10px;}
.media-queue.open{display:flex;}
.media-queue-item{display:flex;gap:10px;align-items:flex-start;padding:10px;background:var(--surface2);border:1px solid var(--border);border-radius:var(--r-sm);}
.media-queue-thumb{width:64px;height:64px;border-radius:12px;object-fit:cover;flex-shrink:0;cursor:pointer;border:1px solid var(--border);}
.media-queue-body{flex:1;min-width:0;}
.media-queue-body textarea{min-height:58px;margin:0;resize:vertical;}
.media-queue-actions{display:flex;justify-content:flex-end;gap:6px;margin-top:6px;}
.media-queue-actions .msg-action-btn{padding:6px 10px;}
.media-queue-send{width:100%;margin-top:2px;}
#videoViewer{position:fixed;inset:0;background:rgba(0,0,0,.97);z-index:9999;display:none;align-items:center;justify-content:center;cursor:pointer;}
#videoViewer.open{display:flex;}
#videoViewerVideo{max-width:95vw;max-height:95vh;border-radius:12px;object-fit:contain;background:#000;cursor:default;}

/* === IMAGE VIEWER === */
#imgViewer{position:fixed;inset:0;background:rgba(0,0,0,.97);z-index:9999;display:none;align-items:center;justify-content:center;cursor:pointer;}
#imgViewer.open{display:flex;}
#imgViewer img{max-width:95vw;max-height:95vh;border-radius:8px;object-fit:contain;cursor:default;}
.img-viewer-close{position:absolute;top:16px;right:16px;background:rgba(255,255,255,.15);border:none;border-radius:50%;width:40px;height:40px;font-size:20px;color:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:.2s;z-index:1;}
.img-viewer-close:hover{background:rgba(255,255,255,.25);}

.chat-msg{align-items:flex-start;}
.chat-msg > div.chat-msg-body{min-width:0;flex:1;display:flex;flex-direction:column;gap:4px;}
.chat-bubble{width:fit-content;max-width:min(78%,100%);padding:10px 14px;border-radius:16px;background:var(--surface2);border:1px solid var(--border);font-size:13px;line-height:1.45;word-break:normal;overflow-wrap:anywhere;overflow:hidden;box-sizing:border-box;}
.chat-bubble .chat-time{white-space:nowrap;flex:0 0 auto;align-self:flex-end;}
.chat-bubble img,.chat-bubble video,.chat-bubble audio{max-width:100%;}
.chat-msg.me .chat-msg-body{align-items:flex-end;}
.chat-msg.me .chat-bubble{background:var(--pri-dim);border-color:rgba(34,211,165,.3);color:var(--primary);}
.chat-time{font-size:10px;color:var(--muted);margin-top:3px;white-space:nowrap;}
.msg-media-wrap{display:block;max-width:100%;overflow:hidden;border-radius:12px;}
.msg-media-img{max-width:100%;width:100%;height:auto;max-height:260px;border-radius:12px;cursor:pointer;display:block;object-fit:cover;margin-top:4px;}
.msg-media-video{max-width:100%;width:100%;height:auto;max-height:260px;border-radius:12px;display:block;margin-top:4px;}
