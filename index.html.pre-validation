  // ─── FIX iOS SCROLL LOCK EDGE CASE ──────────────────────────────
  // When modals are closed while keyboard is open, scrollY can be wrong
  // Listen for visual viewport changes and update scroll lock
  if(window.visualViewport && iOS){
    window.visualViewport.addEventListener('resize', () => {
      // If modal is open and keyboard shown/hidden, reposition modal
      const modal = document.getElementById('userProfileModal');
