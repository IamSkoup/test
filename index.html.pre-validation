    deliveryMapObj=L.map(mapEl,{center,zoom:hasCoords?16:14});
    addSatelliteLayer(deliveryMapObj);
    if(hasCoords){L.marker([order.addrLat,order.addrLng],{icon:L.divIcon({html:'<div style="background:#22d3a5;width:28px;height:28px;border-radius:50%;border:3px solid white;box-shadow:0 2px 14px rgba(34,211,165,.8);display:flex;align-items:center;justify-content:center;font-size:15px;">📍</div>',iconSize:[28,28],iconAnchor:[14,14],className:''})}).addTo(deliveryMapObj).bindPopup(`<b>📍 Адрес доставки</b><br>${escHtml(order.address||'')}`).openPopup();}
