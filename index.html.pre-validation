        casino.innerHTML=`<div class="card" style="background:linear-gradient(145deg,rgba(248,113,113,.08),rgba(251,191,36,.05));border-color:rgba(248,113,113,.25);"><div style="font-size:22px;font-weight:900;">🎰 Казино</div><div style="font-size:12px;color:var(--muted);margin-top:4px;">Отдельный игровой баланс · Блекджек, слоты и новые мини-игры</div><div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:12px;"><div style="padding:12px;border-radius:12px;background:var(--surface2);border:1px solid var(--border);"><div style="font-size:10px;color:var(--muted);text-transform:uppercase;font-weight:900;">Основной баланс</div><div id="casinoMainBalanceDisplay" style="margin-top:3px;font-size:18px;font-weight:900;color:var(--text);">0 ₽</div></div><div style="padding:12px;border-radius:12px;background:rgba(248,113,113,.08);border:1px solid rgba(248,113,113,.25);"><div style="font-size:10px;color:var(--muted);text-transform:uppercase;font-weight:900;">Баланс казино</div><div id="casinoBalanceDisplay" style="margin-top:3px;font-size:18px;font-weight:900;color:var(--gold);">0 ₽</div></div></div><div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px;"><input type="number" id="casinoTransferAmt" min="1" step="1" placeholder="Сумма, ₽" style="margin:0;"><button class="btn btn-gold btn-sm" onclick="kapaniCasinoDeposit()">➕ Внести</button></div><div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:8px;"><button class="btn btn-ghost btn-sm" onclick="kapaniCasinoWithdraw()">➖ Вывести от 500 ₽</button><div style="font-size:10px;color:var(--muted);display:flex;align-items:center;justify-content:center;text-align:center;line-height:1.35;">Вывод доступен только с игрового баланса</div></div></div><div class="card" id="blackjackArea"></div><div class="card" id="slotsArea"></div><div class="card" id="rouletteArea"></div><div class="card" id="coinflipArea"></div><div class="card" id="diceArea"></div>`;
        main.appendChild(casino);
