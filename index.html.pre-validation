.np-icon{font-size:24px;flex-shrink:0;}
.np-body{flex:1;min-width:0;}
.np-text{font-size:13px;font-weight:700;line-height:1.4;}
.np-time{font-size:10px;color:var(--muted);margin-top:2px;}
.np-close{font-size:18px;color:var(--muted);cursor:pointer;transition:.2s;padding:4px;}
.np-close:hover{color:var(--text);}
.work-order{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:18px;margin-bottom:12px;}
.work-active{background:linear-gradient(135deg,rgba(34,211,165,.1),rgba(34,211,165,.04));border-color:rgba(34,211,165,.3);}
.map-frame{width:100%;height:460px;border:none;border-radius:var(--r);display:block;}
.profile-header{position:relative;text-align:center;padding:28px 20px 20px;background:linear-gradient(145deg,var(--pri-dim),transparent);border-radius:var(--r);border:1px solid rgba(34,211,165,.2);margin-bottom:14px;overflow:hidden;}
.p-av{width:90px;height:90px;border-radius:26px;object-fit:cover;border:3px solid var(--primary);margin-bottom:12px;box-shadow:0 0 0 6px var(--pri-dim);}
.p-name{font-size:22px;font-weight:900;}
.p-job{color:var(--primary);font-weight:800;font-size:13px;text-transform:uppercase;letter-spacing:.6px;margin-top:4px;}

