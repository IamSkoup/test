        if(id==='tasks') setTimeout(()=>{const u=window.allUsersCache?.[current()]||{};const el=qs('taskBalanceDisplay');if(el)el.textContent=`${Number(u.taskBalance||0).toLocaleString('ru-RU')} ₽`;},80);
