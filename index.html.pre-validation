      if (window.KAPANI_READY && typeof window.KAPANI_READY.then === 'function') {
        try { await window.KAPANI_READY; } catch(e) {}
      }
      if (
        typeof window.dbRef === 'function' &&
        typeof window.dbGet === 'function' &&
        typeof window.dbSet === 'function' &&
        typeof window.dbUpdate === 'function' &&
        typeof window.dbPush === 'function' &&
        typeof window.dbRemove === 'function' &&
        typeof window.runTransaction === 'function' &&
