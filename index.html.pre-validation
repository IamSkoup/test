    await update(listingRef(id),{status:'meeting_requested',buyer:currentNick});
    const pl=l.priceNegotiable?'договорная':`${l.price}₽`;
    await pushNotification(l.seller,`🤝 Купить хочет: ${currentNick} · "${l.title}" · ${pl}`,'market');
