      }catch(e){console.warn('[Kapani economy nav]',e)}
      return ret;
    };

    // Current-page integrations are intentionally lazy and are invoked from nav hooks.
  };
  waitReady().catch(e=>console.error('[Kapani Economy Extension]',e));
})();
