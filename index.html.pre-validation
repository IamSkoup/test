<script>
// Early stubs for fine handlers: if user taps before late module wires
// up, queue the call and replay once real handler is installed.
// Resolution now uses window.KAPANI_READY (set by the main module) instead
// of a setInterval poll — deterministic, fires exactly once, no timers left
// running after the app has started.
(function(){
  var queued = [];
  function makeStub(name){
    var stub = function(){
      var args = Array.prototype.slice.call(arguments);
      var ctx = this;
      var realFn = window['__real_' + name];
      if(typeof realFn === 'function') return realFn.apply(ctx, args);
      queued.push({name: name, ctx: ctx, args: args});
      try { (window.toast || function(){})('⏳ Загрузка… попробуйте ещё раз через секунду','gold'); } catch(e){}
    };
    stub._isStub = true;
    return stub;
  }
  ['submitDutyFine','ksbFineWorker'].forEach(function(n){
    if(typeof window[n] !== 'function') window[n] = makeStub(n);
  });

  function resolveReal(name){
    var cur = window[name];
    if(typeof cur === 'function' && !cur._isStub && !window['__real_' + name]){
      window['__real_' + name] = cur;
      var pending = queued.filter(function(q){ return q.name === name; });
      queued = queued.filter(function(q){ return q.name !== name; });
      pending.forEach(function(q){ try { cur.apply(q.ctx, q.args); } catch(e){ console.error(e); } });
    }
  }
  // The real implementations are installed by the "Kapani Pack v2" module,
  // which itself awaits window.KAPANI_READY. Wait for that same signal, then
  // poll briefly (module eval order isn't guaranteed) and resolve once —
  // no repeating timers left running after startup.
  function waitForReal(){
    var tries = 0;
    (function attempt(){
      resolveReal('submitDutyFine'); resolveReal('ksbFineWorker');
      if(window.__real_submitDutyFine && window.__real_ksbFineWorker) return;
      if(tries++ > 60) { console.error('[Kapani stub] handlers not installed after startup'); return; }
      setTimeout(attempt, 250);
    })();
  }
  if(window.KAPANI_READY && typeof window.KAPANI_READY.then === 'function'){
    window.KAPANI_READY.then(waitForReal);
  } else {
    // Fallback for the unlikely case this script runs after KAPANI_READY was
    // already defined-and-resolved elsewhere, or the bootstrap var is missing.
    waitForReal();
  }
})();
</script>

