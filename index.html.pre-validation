    .ios-device .lb-row,
    .ios-device .dm-user-row,
    .ios-device .market-seller,
    .ios-device .chat-sender,
    .ios-device .driver-card-header,
    .ios-device .submission-top,
    .ios-device .quick-card,
    .ios-device .bn-item,
    .ios-device .msg-action-btn,
    .ios-device .media-ico-btn,
