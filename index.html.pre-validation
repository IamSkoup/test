window.upgradeBizLimit = async function(kind){
    if(_bizUpgradeBusy) return toast('⏳ Покупка уже выполняется…','gold');
    if(!currentBizId) return;
    const price = BIZ_UPGRADE_PRICES[kind];
    if(!price) return;
    const labels = { employee: 'дополнительного сотрудника', product: 'дополнительного товара', priceCap: 'увеличения лимита цены' };
    if(!confirm(`Увеличение количества ${labels[kind] || 'улучшения бизнеса'}

Стоимость: ${price} ₽

После покупки деньги будут списаны с вашего основного баланса.

Подтвердить покупку?`)) return;
    _bizUpgradeBusy = true;
    try{
        const field = kind === 'employee' ? 'employees' : kind === 'product' ? 'products' : 'priceCap';
        const bizSnap = await get(bizItemRef(currentBizId));
        const b = bizSnap.val()||{};
        const result = await runTransaction(userRef(currentNick), current => {
            if(current === null) return;
            const balance = Number(current.balance || 0);
            if(balance < price) return;
            return { ...current, balance: balance - price };
        });
        if(!result || !result.committed) return toast(`❌ Нужно ${price}₽`,'red');
        const bonus = b.limitBonus || {};
        const bizResult = await runTransaction(bizItemRef(currentBizId), current => {
            const cur = current || {};
            const curBonus = cur.limitBonus || {};
            return { ...cur, limitBonus: { ...curBonus, [field]: Number(curBonus[field]||0)+1 } };
        });
        if(!bizResult.committed) throw new Error('Не удалось применить улучшение бизнеса');
        await logTx(currentNick, { type:'out', who:'Бизнес', amt:price, desc:`Улучшение бизнеса: ${labels[kind] || kind}` });
