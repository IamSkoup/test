    const el=qs(id);if(el){el.classList.add('active');curPage=id;}
    for(let i=0;i<12;i++){const b=qs('bn'+i);if(b)b.classList.toggle('sel',bnMap[id]===i);}
    unlockBodyScroll(true); window.scrollTo(0,0);
