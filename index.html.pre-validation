function deliveryBusinessOptions() {
    return Object.values(allBusinessesCache || {})
        .filter(b => b && b.status === 'active' && b.products && Object.keys(b.products).length)
        .sort((a, b) => String(a.name || '').localeCompare(String(b.name || ''), 'ru'));
