// Leaflet (JS + CSS) is loaded only when a map is actually opened.
window.kapaniLoadLeaflet = (function(){
  let promise = null;
  return function(){
    if(window.L) return Promise.resolve(window.L);
    if(promise) return promise;
    promise = new Promise((resolve,reject)=>{
      let cssReady = false, jsReady = false, settled = false;
      const finish = () => {
        if(!settled && cssReady && jsReady && window.L){ settled = true; resolve(window.L); }
      };
      const css = document.createElement('link');
      css.rel = 'stylesheet';
      css.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
      css.onload = () => { cssReady = true; finish(); };
      css.onerror = () => { if(!settled){ settled=true; promise=null; reject(new Error('Не удалось загрузить стили карты')); } };
      const script = document.createElement('script');
      script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
      script.async = true;
      script.onload = () => { jsReady = true; finish(); };
      script.onerror = () => { if(!settled){ settled=true; promise=null; reject(new Error('Не удалось загрузить карту')); } };
      document.head.appendChild(css);
      document.head.appendChild(script);
    });
    return promise;
  };
})();
</script>

