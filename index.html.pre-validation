        await update(bizItemRef(b.id), { bizWeeklyFeeAt: last + weeks * ECONOMY_WEEK_MS });
        await logTx(nick, { type: 'out', who: b.name || 'Бизнес', amt: fee, desc: `Абонентская плата бизнеса «${b.name}» (${weeks} нед.)` });
        if(opts.notify !== false) await pushNotification(nick, `🏪 Списано ${fee}₽ за ${weeks} нед. наличия бизнеса «${b.name}»`, 'money');
    }
    if(charged > 0){
        await update(userRef(nick), { balance });
        await window.addMunicipalTreasury?.(charged, `Абонентская плата бизнеса от ${nick}`, {sourceNick:nick,sourceType:'business_weekly_fee'});
    }
}
async function processSavingsInterest(nick, u, opts = {}){
    const savings = Number(u.savingsBalance || 0);
    if(savings <= 0) return u;
    const now = Date.now();
    const last = Number(u.savingsLastInterestAt || u.createdAt || now);
    const days = Math.floor((now - last) / ECONOMY_DAY_MS);
    if(days <= 0) return u;
    let total = savings;
    for(let i = 0; i < days; i++){
        const dailyRate = getSavingsDailyRate(total);
        total = Math.round(total * (1 + dailyRate));
    }
    const interest = total - savings;
    const patch = { savingsBalance: total, savingsLastInterestAt: last + days * ECONOMY_DAY_MS };
    await update(userRef(nick), patch);
    if(interest > 0 && opts.notify !== false){
        await logTx(nick, { type: 'in', who: 'Накопительный счёт', amt: interest, desc: `Начисление ${days} дн. по действующей ставке` });
        await pushNotification(nick, `📈 Накопительный счёт: +${interest}₽ за ${days} дн.`, 'money');
    }
    return { ...u, ...patch };
}

async function processEconomyChargesForUser(nick, opts = {}) {
    if(!nick || economyMaintenanceBusy) return null;
    economyMaintenanceBusy = true;
    try {
        const snap = await get(userRef(nick));
        if(!snap.exists()) return null;
        const u = snap.val() || {};
        const now = Date.now();
        const hasMarker = !!u.economyLastProcessedAt;
        const lastProcessed = hasMarker ? Number(u.economyLastProcessedAt) : now;

        if(!hasMarker){
            await update(userRef(nick), { economyLastProcessedAt: now });
            return u;
        }

        const weeks = Math.floor((now - lastProcessed) / ECONOMY_WEEK_MS);
        if(weeks <= 0) return u;

        const marker = lastProcessed + weeks * ECONOMY_WEEK_MS;
        const txIdPrefix = `tax_${nick}_${marker}`;
        const result = await runTransaction(userRef(nick), current => {
            if(current === null) return;
            const next = { ...current };
            let mainBalance = Number(next.balance || 0);
            if(!Number.isFinite(mainBalance)) mainBalance = 0;
            let savingsBalance = Number(next.savingsBalance || 0);
            if(!Number.isFinite(savingsBalance)) savingsBalance = 0;
            const notifications = [];
            let processedAt = Number(next.economyLastProcessedAt || lastProcessed);

            for(let i = 1; i <= weeks; i++){
                const periodMarker = lastProcessed + i * ECONOMY_WEEK_MS;
                const taxBase = Math.max(0, mainBalance) + Math.max(0, savingsBalance);
                const rate = getWealthTaxRate(taxBase);
                const wealthTax = taxBase > 0 ? Math.round(taxBase * rate) : 0;
                const accountFee = ECONOMY_ACCOUNT_WEEKLY_FEE;
                const total = accountFee + wealthTax;
                mainBalance -= total;
                const receiptId = `${nick}_tax_${periodMarker}`.replace(/[.#$\[\]\/]/g,'_');
                notifications.push({ accountFee, wealthTax, taxBase, rate, total });
                processedAt = periodMarker;
            }

            next.balance = mainBalance;
            next.economyLastProcessedAt = processedAt;
            return next;
        });
        if(!result || !result.committed) return u;

        let treasuryTotal=0;
        let treasuryMain=Number(u.balance||0);
        const treasurySavings=Number(u.savingsBalance||0);
        for(let i=1;i<=weeks;i++){
            const taxBase=Math.max(0,treasuryMain)+Math.max(0,treasurySavings);
            const wealthTax=taxBase>0?Math.round(taxBase*getWealthTaxRate(taxBase)):0;
            treasuryTotal+=ECONOMY_ACCOUNT_WEEKLY_FEE+wealthTax;
            treasuryMain-=ECONOMY_ACCOUNT_WEEKLY_FEE+wealthTax;
        }
        if(treasuryTotal>0) await window.addMunicipalTreasury?.(treasuryTotal, `Налоги и абонентская плата: ${nick}`, {sourceNick:nick,sourceType:'tax_and_account_fee'});

        const updated = result.snapshot.val() || {};
        if(opts.notify !== false){
            const weeksApplied = weeks;
            let curMain = Number(u.balance || 0);
            let curSavings = Number(u.savingsBalance || 0);
            const notices = [];
            for(let i = 1; i <= weeksApplied; i++){
                const taxBase = Math.max(0, curMain) + Math.max(0, curSavings);
                const rate = getWealthTaxRate(taxBase);
                const wealthTax = taxBase > 0 ? Math.round(taxBase * rate) : 0;
                const total = ECONOMY_ACCOUNT_WEEKLY_FEE + wealthTax;
                curMain -= total;
                notices.push({taxBase, rate, wealthTax, total});
            }
            const lastNotice = notices[notices.length-1];
            if(lastNotice){
                const parts = [`абонентская плата ${ECONOMY_ACCOUNT_WEEKLY_FEE}₽`];
                if(lastNotice.wealthTax > 0) parts.push(`налог ${Math.round(lastNotice.rate*100)}% = ${lastNotice.wealthTax}₽`);
                await pushNotification(nick, `💳 Списано за ${weeksApplied} нед.: ${parts.join(' + ')}. Налог считается с основного + накопительного счёта и списывается только с основного.`, 'money');
                toast(`💳 Налог и абонентская плата: ${weeksApplied} нед.`, 'gold');
            }
        }
        return {...u, ...updated};
    } catch(e) {
        console.warn('Economy maintenance failed:', e);
        return null;
    } finally {
        economyMaintenanceBusy = false;
    }
}

